{
  "name": "@nstdata-ai/crawl",
  "version": "2.0.0",
  "description": "Node.js SDK for nstdata",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22.18.0 <23 || >=24.0.0 <25"
  },
  "files": [
    "dist",
    "README.md",
    "README_zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nstdata-ai/crawl-node.git"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit --strict --target ES2022 --module CommonJS --esModuleInterop --skipLibCheck example.ts",
    "test": "npm run build && node --test test/*.test.cjs",
    "example": "ts-node example.ts",
    "check:package": "node scripts/check-package.cjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "scraper",
    "crawler",
    "nstdata"
  ],
  "author": "nstdata-ai",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^18.0.0",
    "ts-node": "^10.9.1"
  }
}
